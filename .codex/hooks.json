{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_CAPTURE_TOOL=codex python3 \"$(git rev-parse --show-toplevel)/.claude/capture.py\" prompt",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_CAPTURE_TOOL=codex python3 \"$(git rev-parse --show-toplevel)/.claude/capture.py\" response",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
